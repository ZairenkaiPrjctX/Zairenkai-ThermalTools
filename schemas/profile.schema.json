{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zairenkaiprjctx.github.io/schemas/zthermal/profile.schema.json",
  "title": "zthermal device profile",
  "description": "profiles/*.json. A profile records what is known about a device family and the evidence for it. It never grants a control: `controls` may only name validated allowlist entries. Further rules (evidence kinds, SoC consistency) are enforced by `zthermal profile-validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "oem", "brands", "family", "devices", "soc", "min_sdk", "config_files", "controls", "evidence", "validation", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "oem": {"type": "string"},
    "brands": {"type": "array", "items": {"type": "string"}},
    "family": {"type": "string"},
    "devices": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "soc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model", "board_platform"],
      "properties": {
        "vendor": {"enum": ["qualcomm", "mediatek", "google_tensor", "samsung_exynos", "unisoc", "unknown"]},
        "model": {"type": ["string", "null"]},
        "board_platform": {"type": ["string", "null"]}
      }
    },
    "min_sdk": {"type": ["integer", "null"], "minimum": 1},
    "config_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "path", "evidence"],
        "properties": {
          "format": {"enum": ["qcom_thermal_engine", "pixel_thermal_info_json"]},
          "path": {"type": "string", "pattern": "^/"},
          "evidence": {"type": "string"}
        }
      }
    },
    "controls": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "note"],
        "properties": {
          "kind": {"enum": ["official_documentation", "public_source", "verified_artifact", "hardware_test", "inference", "assumption"]},
          "reference": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_tested", "last_reviewed"],
      "properties": {
        "hardware_tested": {"type": "boolean"},
        "last_reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
